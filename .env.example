# Copy to .env and replace each value. Do NOT put comments on the same line as secrets.

# Entra tenant ID (Overview blade in Microsoft Entra ID)
AZURE_TENANT_ID=

# App registration application (client) ID
AZURE_CLIENT_ID=

# App registration client secret (Certificates & secrets)
AZURE_CLIENT_SECRET=

# Optional: subscription GUID for ARM RBAC (leave empty for directory-only)
AZURE_SUBSCRIPTION_ID=

STALE_PIM_THRESHOLD_HOURS=24
STALE_RBAC_THRESHOLD_HOURS=48
REPORT_CADENCE_DAYS=7
